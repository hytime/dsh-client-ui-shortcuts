{
  "name": "@hytime/dsh-client-ui-shortcuts",
  "version": "0.2.0",
  "description": "Quick panel using official DSH shortcuts, with opt-in question and approval enhancements",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "keyboard-shortcuts",
    "web-client"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hytime/dsh-client-ui-shortcuts.git"
  },
  "homepage": "https://github.com/hytime/dsh-client-ui-shortcuts#readme",
  "bugs": {
    "url": "https://github.com/hytime/dsh-client-ui-shortcuts/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "clean:lib": "node scripts/clean-lib.mjs",
    "build:types": "pnpm run clean:lib && tsc",
    "bundle": "pnpm run build:types && tsdown",
    "prepare": "pnpm run bundle",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "files": ["lib/index.js", "lib/invariant.js", "lib/client.js", "lib/types/**/*.d.ts", "cordis.patch.yml", "README.zh.md", "CHANGELOG.md", "CHANGELOG.zh.md"],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4",
    "@iconify-icons/lucide": "1.2.136",
    "@iconify/react": "6.0.2",
    "clsx": "2.1.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.0-rc.1 <1.0.0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.1 <1.0.0",
    "@deepseek-ai/dsh-client-shortcuts": ">=0.2.0-rc.1 <1.0.0",
    "@deepseek-ai/dsh-client-store": ">=0.2.0-rc.1 <1.0.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.0-rc.1 <1.0.0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.2.0-rc.1 <1.0.0",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.2.0-rc.1 <1.0.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.1 <1.0.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.0-rc.1 <1.0.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.0-rc.1 <1.0.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.1 <1.0.0",
    "@deepseek-ai/dsh-invariants": ">=0.2.0-rc.1 <1.0.0",
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.1 <1.0.0",
    "react": ">=18.2.0 <19.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-shortcuts": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-store": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.1",
    "@deepseek-ai/dsh-invariants": "0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.0",
    "@types/react": "18.3.1",
    "jsdom": "29.1.1",
    "lightningcss": "1.32.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8",
    "yaml": "2.9.0"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
